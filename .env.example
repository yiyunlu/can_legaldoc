# === PostgreSQL (required, auto-set by docker-compose) ===
# For Docker: set POSTGRES_PASSWORD and docker-compose builds the URL automatically
# For local dev: set DATABASE_URL directly
POSTGRES_PASSWORD=change_me_in_production
# DATABASE_URL=postgresql://canlii:change_me_in_production@localhost:5432/canlii

# === Supabase (optional, only needed for migration) ===
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key

# === Scraper Config ===
REQUEST_DELAY=1.5
LOG_LEVEL=INFO
MAX_RETRIES=3
TIMEOUT=30

# === Cloudflare Tunnel ===
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# === CORS (set to your Cloudflare tunnel domain in production) ===
# Use * for local development, restrict in production
ALLOWED_ORIGIN=https://canlii.your-domain.com
